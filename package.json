{
  "name": "projectchat",
  "productName": "Cue",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "exyyyl",
  "description": "Live interaction tools and OBS overlays for streamers",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:panel": "npm --prefix ui/panel run build",
    "dev:panel": "npm --prefix ui/panel run dev",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "desktop": "node scripts/dev-desktop.mjs",
    "desktop:static": "electron .",
    "pack:win": "node scripts/package-desktop.mjs --win",
    "pack:mac": "node scripts/package-desktop.mjs --mac",
    "pack:trula": "node scripts/package-trula-plugin.mjs",
    "release:win": "node scripts/package-desktop.mjs --win --release"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4",
    "ws": "8.22.1"
  }
}
