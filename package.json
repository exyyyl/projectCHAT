{
  "name": "projectchat",
  "productName": "projectCHAT",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "projectCHAT",
  "description": "Local poll control panel and OBS browser overlay",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "build:panel": "npm --prefix ui/panel run build",
    "dev:panel": "npm --prefix ui/panel run dev",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "desktop": "electron .",
    "pack:win": "node scripts/package-desktop.mjs --win",
    "pack:mac": "node scripts/package-desktop.mjs --mac",
    "release:win": "node scripts/package-desktop.mjs --win --release"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4"
  }
}
